#!/usr/bin/env bash
# Remove EVERY worktree of this repo — no PR, dirty, or open-work checks.
#
# Usage: bin/worktree-sweep            # act
#        bin/worktree-sweep --dry-run  # print what would be removed, change nothing
#
# Covers every worktree registered with this repo except the main checkout (pipeline
# .claude/worktrees/* and sibling ../<app>-* from /worktree alike), plus any leftover directory
# under .claude/worktrees/ that git no longer knows about. For each it stops the dev server on
# the worktree's own PORT (only when its .env sets one — never the main checkout's port), drops
# the <app>_development/<app>_test databases matching its DATABASE_SUFFIX (including
# parallel_rspec numbered ones), and runs `git worktree remove --force` (uncommitted changes
# are discarded). Branches are never deleted, so committed work survives.
#
# Exit status: 0, or 1 if any "error —" line was printed.
set -uo pipefail

# Database name prefix from config/database.yml (e.g. "myapp" for myapp_development).
# Override with APP_DB_PREFIX=... if auto-detection doesn't fit your database.yml.
APP_DB_PREFIX="${APP_DB_PREFIX:-$(sed -n 's/^ *database: *\([a-z0-9_]*\)_development.*/\1/p' "$(git rev-parse --show-toplevel)/config/database.yml" | head -1)}"
if [ -z "$APP_DB_PREFIX" ]; then
  echo "Could not detect the database name prefix from config/database.yml — set APP_DB_PREFIX" >&2
  exit 2
fi

DRY_RUN=0
case "${1:-}" in
  --dry-run) DRY_RUN=1 ;;
  "") ;;
  *) echo "Usage: bin/worktree-sweep [--dry-run]" >&2; exit 2 ;;
esac

MAIN_DIR="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
WT_ROOT="$MAIN_DIR/.claude/worktrees"
HAD_ERROR=0

git -C "$MAIN_DIR" worktree prune

# Registered worktrees other than the main checkout, then unregistered .claude/worktrees/* dirs.
targets=()
while IFS= read -r d; do
  [ "$d" = "$MAIN_DIR" ] || targets+=("$d")
done < <(git -C "$MAIN_DIR" worktree list --porcelain | awk '/^worktree /{sub(/^worktree /,""); print}')
REGISTERED_COUNT=${#targets[@]}

shopt -s nullglob
for d in "$WT_ROOT"/*/; do
  d="${d%/}"
  printf '%s\n' "${targets[@]:-}" | grep -qxF "$d" || targets+=("$d")
done
shopt -u nullglob

if [ ${#targets[@]} -eq 0 ]; then
  echo "No worktrees to remove"
  exit 0
fi

env_value() {
  grep -s "^$2=" "$1/.env" | tail -1 | cut -d= -f2 | tr -d '"'"'"' ' || true
}

stop_server() {
  [ -n "$port" ] || return 0
  local pids i
  pids="$(lsof -ti tcp:"$port" 2>/dev/null || true)"
  [ -n "$pids" ] || return 0
  kill $pids 2>/dev/null || true
  for i in 1 2 3 4 5; do
    pids="$(lsof -ti tcp:"$port" 2>/dev/null || true)"
    [ -z "$pids" ] && return 0
    sleep 1
  done
  kill -9 $pids 2>/dev/null || true
  return 0
}

# Prints the DBs that could not be dropped (empty on success). No suffix → nothing dropped,
# so the shared <app>_development/<app>_test are never touched.
drop_databases() {
  [ -n "$suffix" ] || return 0
  local dbs db remaining=""
  dbs="$(psql -Atc "SELECT datname FROM pg_database WHERE datname ~ '^${APP_DB_PREFIX}_(development|test)${suffix}[0-9]*$'" postgres 2>/dev/null || true)"
  for db in $dbs; do
    if ! dropdb --if-exists "$db" >/dev/null 2>&1; then
      psql -Atc "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$db'" postgres >/dev/null 2>&1
      dropdb --if-exists "$db" >/dev/null 2>&1 || remaining="$remaining $db"
    fi
  done
  echo "${remaining# }"
}

for i in "${!targets[@]}"; do
  d="${targets[$i]}"
  registered=0
  [ "$i" -lt "$REGISTERED_COUNT" ] && registered=1
  name="${d#"$(dirname "$MAIN_DIR")"/}"
  port="$(env_value "$d" PORT)"
  suffix="$(env_value "$d" DATABASE_SUFFIX)"
  dbs_note="${suffix:+, dbs ${APP_DB_PREFIX}_*${suffix}}"

  if [ $DRY_RUN -eq 1 ]; then
    echo "$name: would remove${port:+ (port $port)}${dbs_note}"; continue
  fi

  stop_server
  failed_dbs="$(drop_databases)"
  if [ -n "$failed_dbs" ]; then
    echo "$name: error — could not drop $failed_dbs; worktree kept (its .env is needed to retry)"
    HAD_ERROR=1; continue
  fi
  if [ $registered -eq 1 ]; then
    if ! err="$(git -C "$MAIN_DIR" worktree remove --force --force "$d" 2>&1)"; then
      echo "$name: error — git worktree remove failed: $err"
      HAD_ERROR=1; continue
    fi
  else
    rm -rf -- "$d"
  fi
  echo "$name: removed${dbs_note}"
done

git -C "$MAIN_DIR" worktree prune
exit $HAD_ERROR
